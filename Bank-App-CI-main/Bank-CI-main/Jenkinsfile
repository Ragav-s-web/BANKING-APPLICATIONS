pipeline {

    agent any

    tools {
        jdk 'Java21'
        maven 'Maven'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'git-token',
                    url: 'https://github.com/Ragav-s-web/BANKING-APPLICATIONS.git'
            }
        }

        stage('Check Java & Maven') {
            steps {
                sh '''
                    echo "JAVA_HOME=$JAVA_HOME"
                    java -version
                    javac -version
                    mvn -version
                '''
            }
        }

        stage('Clean') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    sh 'mvn clean'
                }
            }
        }

        stage('Compile') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    withSonarQubeEnv('sonar') {
                        sh '''
                            mvn sonar:sonar \
                            -Dsonar.projectKey=gcbank \
                            -Dsonar.projectName=gcbank \
                            -Dsonar.java.binaries=target/classes
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: false
                    )
                }
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESSFUL'
        }

        failure {
            echo 'BUILD FAILED'
        }
    }
}
