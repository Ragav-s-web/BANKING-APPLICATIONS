pipeline {

    agent any

    tools {
        jdk 'Java21'
        maven 'Maven'
    }

    environment {

        // Application directory
        APP_DIR = 'Bank-App-CI-main/Bank-CI-main'

        // SonarQube
        SONAR_PROJECT_KEY = 'gcbank'
        SONAR_PROJECT_NAME = 'gcbank'

        // Docker
        DOCKER_IMAGE = 'castromeka/gcbank'
        IMAGE_TAG = "v${BUILD_NUMBER}"
    }

    stages {

        // =========================================================
        // 1. CLEAN WORKSPACE
        // =========================================================

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }


        // =========================================================
        // 2. CHECKOUT FROM GITHUB
        // =========================================================

        stage('Git Checkout') {
            steps {

                git(
                    branch: 'main',
                    credentialsId: 'git-token',
                    url: 'https://github.com/Ragav-s-web/BANKING-APPLICATIONS.git'
                )
            }
        }


        // =========================================================
        // 3. VERIFY JAVA AND MAVEN
        // =========================================================

        stage('Check Java & Maven') {
            steps {

                sh '''
                    echo "=========================================="
                    echo "JAVA VERSION"
                    echo "=========================================="

                    java -version

                    echo ""
                    echo "=========================================="
                    echo "JAVAC VERSION"
                    echo "=========================================="

                    javac -version

                    echo ""
                    echo "=========================================="
                    echo "JAVA HOME"
                    echo "=========================================="

                    echo "$JAVA_HOME"

                    echo ""
                    echo "=========================================="
                    echo "MAVEN VERSION"
                    echo "=========================================="

                    mvn -version
                '''
            }
        }


        // =========================================================
        // 4. CLEAN MAVEN PROJECT
        // =========================================================

        stage('Maven Clean') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        mvn clean
                    '''
                }
            }
        }


        // =========================================================
        // 5. COMPILE
        // =========================================================

        stage('Compile') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        mvn compile
                    '''
                }
            }
        }


        // =========================================================
        // 6. UNIT TEST
        // =========================================================

        stage('Test') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        mvn test
                    '''
                }
            }
        }


        // =========================================================
        // 7. SONARQUBE ANALYSIS
        // =========================================================

        stage('SonarQube Analysis') {
            steps {

                dir("${APP_DIR}") {

                    withSonarQubeEnv('sonar') {

                        sh '''
                            mvn clean verify sonar:sonar \
                              -Dsonar.projectKey=hggg \
                              -Dsonar.host.url=http://35.180.123.141:9000 \
                              -Dsonar.login=sqp_db4003d5c5d614c4fdd0c50b4c9085cbd958cd16
                        '''
                    }
                }
            }
        }


        // =========================================================
        // 8. QUALITY GATE
        // =========================================================

        stage('Quality Gate') {
            steps {

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: false
                    )
                }
            }
        }


        // =========================================================
        // 9. CREATE JAR
        // =========================================================

        stage('Package') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        mvn package -DskipTests
                    '''
                }
            }
        }


        // =========================================================
        // 10. SHOW BUILD ARTIFACT
        // =========================================================

        stage('Show Artifact') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "BUILD ARTIFACT"
                        echo "=========================================="

                        ls -lh target/
                    '''
                }
            }
        }


        // =========================================================
        // 11. DOCKER BUILD
        // =========================================================

        stage('Docker Build') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "BUILDING DOCKER IMAGE"
                        echo "=========================================="

                        docker build \
                            -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                            .
                    '''
                }
            }
        }


        // =========================================================
        // 12. DOCKER IMAGE CHECK
        // =========================================================

        stage('Docker Image Check') {
            steps {

                sh '''
                    echo "=========================================="
                    echo "DOCKER IMAGE"
                    echo "=========================================="

                    docker images ${DOCKER_IMAGE}

                    echo ""
                    echo "IMAGE:"
                    echo "${DOCKER_IMAGE}:${IMAGE_TAG}"
                '''
            }
        }


        // =========================================================
        // 13. PUSH DOCKER IMAGE
        // =========================================================

        stage('Docker Push') {
            steps {

                script {

                    withDockerRegistry(
                        credentialsId: 'docker-cred'
                    ) {

                        sh '''
                            echo "=========================================="
                            echo "PUSHING DOCKER IMAGE"
                            echo "=========================================="

                            docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                        '''
                    }
                }
            }
        }
    }


    // =============================================================
    // POST ACTIONS
    // =============================================================

    post {

        success {

            echo '''
            ==========================================
              BANKING APPLICATION PIPELINE SUCCESS
            ==========================================
            '''

            echo "Application build completed successfully."

            echo "Docker Image:"
            echo "${DOCKER_IMAGE}:${IMAGE_TAG}"
        }


        failure {

            echo '''
            ==========================================
              BANKING APPLICATION PIPELINE FAILED
            ==========================================
            '''

            echo "Check the Jenkins Console Output."
        }


        always {

            echo "=========================================="
            echo "BUILD INFORMATION"
            echo "=========================================="

            echo "BUILD NUMBER : ${BUILD_NUMBER}"
            echo "BUILD STATUS : ${currentBuild.currentResult}"
        }
    }
}
