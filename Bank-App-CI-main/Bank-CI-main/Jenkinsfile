node {

    // =========================================================
    // TOOL CONFIGURATION
    // =========================================================

    def javaHome = tool 'Java21'
    def mavenHome = tool 'Maven'

    env.JAVA_HOME = javaHome
    env.PATH = "${javaHome}/bin:${mavenHome}/bin:${env.PATH}"

    // =========================================================
    // VARIABLES
    // =========================================================

    def APP_DIR = 'Bank-App-CI-main/Bank-CI-main'

    def SONAR_PROJECT_KEY = 'gcbank'
    def SONAR_PROJECT_NAME = 'gcbank'

    def DOCKER_IMAGE = 'castromeka/gcbank'
    def IMAGE_TAG = "v${env.BUILD_NUMBER}"

    try {

        // =====================================================
        // 1. CLEAN WORKSPACE
        // =====================================================

        stage('Clean Workspace') {

            cleanWs()

        }


        // =====================================================
        // 2. GIT CHECKOUT
        // =====================================================

        stage('Git Checkout') {

            git(
                branch: 'main',
                credentialsId: 'git-token',
                url: 'https://github.com/Ragav-s-web/BANKING-APPLICATIONS.git'
            )

        }


        // =====================================================
        // 3. CHECK JAVA AND MAVEN
        // =====================================================

        stage('Check Java & Maven') {

            sh '''
                echo "=========================================="
                echo "JAVA VERSION"
                echo "=========================================="

                java -version

                echo ""
                echo "=========================================="
                echo "JAVAC VERSION"
                echo "=========================================="

                javac -version

                echo ""
                echo "=========================================="
                echo "JAVA HOME"
                echo "=========================================="

                echo "$JAVA_HOME"

                echo ""
                echo "=========================================="
                echo "MAVEN VERSION"
                echo "=========================================="

                mvn -version
            '''

        }


        // =====================================================
        // 4. MAVEN CLEAN
        // =====================================================

        stage('Maven Clean') {

            dir(APP_DIR) {

                sh '''
                    echo "=========================================="
                    echo "MAVEN CLEAN"
                    echo "=========================================="

                    mvn clean
                '''

            }

        }


        // =====================================================
        // 5. COMPILE
        // =====================================================

        stage('Compile') {

            dir(APP_DIR) {

                sh '''
                    echo "=========================================="
                    echo "MAVEN COMPILE"
                    echo "=========================================="

                    mvn compile
                '''

            }

        }


        // =====================================================
        // 6. UNIT TEST
        // =====================================================

        stage('Test') {

            dir(APP_DIR) {

                sh '''
                    echo "=========================================="
                    echo "UNIT TEST"
                    echo "=========================================="

                    mvn test
                '''

            }

        }


        // =====================================================
        // 7. SONARQUBE ANALYSIS
        // =====================================================

        stage('SonarQube Analysis') {

            dir(APP_DIR) {

                withSonarQubeEnv('sonar') {

                    withCredentials([
                        string(
                            credentialsId: 'sonar-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {

                        sh '''
                            echo "=========================================="
                            echo "SONARQUBE ANALYSIS"
                            echo "=========================================="

                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.7.0.6970:sonar \
                                -Dsonar.projectKey=gcbank \
                                -Dsonar.projectName=gcbank \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.token=${SONAR_TOKEN} \
                                -Dsonar.java.binaries=target/classes
                        '''

                    }

                }

            }

        }


        // =====================================================
        // 8. QUALITY GATE
        // =====================================================

        stage('Quality Gate') {

            timeout(
                time: 5,
                unit: 'MINUTES'
            ) {

                waitForQualityGate(
                    abortPipeline: false
                )

            }

        }


        // =====================================================
        // 9. CREATE JAR
        // =====================================================

        stage('Package') {

            dir(APP_DIR) {

                sh '''
                    echo "=========================================="
                    echo "CREATING JAR"
                    echo "=========================================="

                    mvn package -DskipTests
                '''

            }

        }


        // =====================================================
        // 10. SHOW ARTIFACT
        // =====================================================

        stage('Show Artifact') {

            dir(APP_DIR) {

                sh '''
                    echo "=========================================="
                    echo "BUILD ARTIFACT"
                    echo "=========================================="

                    ls -lh target/
                '''

            }

        }


        // =====================================================
        // 11. DOCKER CHECK
        // =====================================================

        stage('Docker Check') {

            sh '''
                echo "=========================================="
                echo "DOCKER VERSION"
                echo "=========================================="

                docker --version
            '''

        }


        // =====================================================
        // 12. DOCKER BUILD
        // =====================================================

        stage('Docker Build') {

            dir(APP_DIR) {

                sh """
                    echo "=========================================="
                    echo "BUILDING DOCKER IMAGE"
                    echo "=========================================="

                    docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} .

                    echo ""
                    echo "Docker image:"
                    echo "${DOCKER_IMAGE}:${IMAGE_TAG}"
                """

            }

        }


        // =====================================================
        // 13. DOCKER IMAGE CHECK
        // =====================================================

        stage('Docker Image Check') {

            sh """
                echo "=========================================="
                echo "DOCKER IMAGE"
                echo "=========================================="

                docker images ${DOCKER_IMAGE}

                echo ""
                echo "IMAGE:"
                echo "${DOCKER_IMAGE}:${IMAGE_TAG}"
            """

        }


        // =====================================================
        // 14. DOCKER LOGIN
        // =====================================================

        stage('Docker Login') {

            withCredentials([
                usernamePassword(
                    credentialsId: 'docker-cred',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {

                sh '''
                    echo "=========================================="
                    echo "DOCKER HUB LOGIN"
                    echo "=========================================="

                    echo "$DOCKER_PASSWORD" | docker login \
                        --username "$DOCKER_USERNAME" \
                        --password-stdin
                '''

            }

        }


        // =====================================================
        // 15. DOCKER PUSH
        // =====================================================

        stage('Docker Push') {

            sh """
                echo "=========================================="
                echo "PUSHING DOCKER IMAGE"
                echo "=========================================="

                echo "Docker Image:"
                echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
            """

        }


        // =====================================================
        // 16. DOCKER LOGOUT
        // =====================================================

        stage('Docker Logout') {

            sh '''
                echo "=========================================="
                echo "DOCKER LOGOUT"
                echo "=========================================="

                docker logout || true
            '''

        }


        // =====================================================
        // SUCCESS
        // =====================================================

        echo ""
        echo "=========================================="
        echo "BANKING APPLICATION PIPELINE SUCCESS"
        echo "=========================================="
        echo "Build Number : ${env.BUILD_NUMBER}"
        echo "Docker Image : ${DOCKER_IMAGE}:${IMAGE_TAG}"
        echo "Status       : SUCCESS"
        echo "=========================================="

    }

    catch (Exception e) {

        echo ""
        echo "=========================================="
        echo "BANKING APPLICATION PIPELINE FAILED"
        echo "=========================================="
        echo "Build Number : ${env.BUILD_NUMBER}"
        echo "Status       : FAILED"
        echo "=========================================="

        throw e

    }

    finally {

        echo ""
        echo "=========================================="
        echo "BUILD INFORMATION"
        echo "=========================================="
        echo "BUILD NUMBER : ${env.BUILD_NUMBER}"
        echo "=========================================="

    }

}
