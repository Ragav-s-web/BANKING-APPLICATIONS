pipeline {

    agent any

    tools {
        jdk 'Java21'
        maven 'Maven'
    }

    environment {
        IMAGE_TAG = "v${BUILD_NUMBER}"
        DOCKER_IMAGE = "castromeka/gcbank"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'git-token',
                    url: 'https://github.com/Ragav-s-web/BANKING-APPLICATIONS.git'
            }
        }

        stage('Check Java & Maven') {
            steps {
                sh '''
                    echo "========== JAVA VERSION =========="
                    java -version

                    echo "========== MAVEN VERSION =========="
                    mvn -version

                    echo "========== JAVA HOME =========="
                    echo $JAVA_HOME
                '''
            }
        }

        stage('Compile') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Testing') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    sh 'mvn test'
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                sh '''
                    trivy fs \
                    --format table \
                    -o fs-report.html \
                    .
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {

                    withSonarQubeEnv('sonar') {

                        sh '''
                            mvn sonar:sonar \
                            -Dsonar.projectKey=gcbank \
                            -Dsonar.projectName=gcbank \
                            -Dsonar.java.binaries=target/classes
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {

                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'sonar-token'
                    )
                }
            }
        }

        stage('Build Package') {
            steps {
                dir('Bank-App-CI-main/Bank-CI-main') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Publish to Nexus') {
            steps {

                dir('Bank-App-CI-main/Bank-CI-main') {

                    withMaven(
                        globalMavenSettingsConfig: 'mekadevops',
                        maven: 'Maven',
                        traceability: true
                    ) {

                        sh 'mvn deploy -DskipTests'
                    }
                }
            }
        }

        stage('Docker Image Build') {
            steps {

                dir('Bank-App-CI-main/Bank-CI-main') {

                    sh '''
                        docker build \
                        -t ${DOCKER_IMAGE}:${IMAGE_TAG} .
                    '''
                }
            }
        }

        stage('Trivy Docker Image Scan') {
            steps {

                sh '''
                    trivy image \
                    --format table \
                    -o image-report.html \
                    ${DOCKER_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('Push Docker Image') {
            steps {

                script {

                    withDockerRegistry(
                        credentialsId: 'docker-cred'
                    ) {

                        sh '''
                            docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                        '''
                    }
                }
            }
        }

        stage('Archive Reports') {
            steps {

                archiveArtifacts(
                    artifacts: '**/*report.html',
                    allowEmptyArchive: true
                )
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo '       PIPELINE SUCCESSFUL'
            echo '======================================'
            echo "Docker Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }

        failure {
            echo '======================================'
            echo '         PIPELINE FAILED'
            echo '======================================'
            echo 'Check the Jenkins console output.'
        }

        always {
            echo "Build ${BUILD_NUMBER} completed."
        }
    }
}
