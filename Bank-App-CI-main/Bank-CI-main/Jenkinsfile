pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    // =========================================================
    // TOOLS
    // =========================================================

    tools {
        jdk 'Java21'
        maven 'Maven'
    }

    // =========================================================
    // ENVIRONMENT
    // =========================================================

    environment {

        // Application directory
        APP_DIR = 'Bank-App-CI-main/Bank-CI-main'

        // SonarQube
        SONAR_PROJECT_KEY = 'gcbank'
        SONAR_PROJECT_NAME = 'gcbank'
        SONARQUBE_CREDENTIALS = credentials('sonarqube-token')

        // Docker Hub
        DOCKER_IMAGE = 'castromeka/gcbank'
        IMAGE_TAG = "v${BUILD_NUMBER}"
    }

    // =========================================================
    // STAGES
    // =========================================================

    stages {

        // =====================================================
        // 1. CLEAN WORKSPACE
        // =====================================================

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        // =====================================================
        // 2. GIT CHECKOUT
        // =====================================================

        stage('Git Checkout') {
            steps {

                echo "=========================================="
                echo "GIT CHECKOUT"
                echo "=========================================="

                git(
                    branch: 'main',
                    credentialsId: 'git-token',
                    url: 'https://github.com/Ragav-s-web/BANKING-APPLICATIONS.git'
                )

                echo "Git checkout completed."
            }
        }

        // =====================================================
        // 3. CHECK JAVA AND MAVEN
        // =====================================================

        stage('Check Java & Maven') {
            steps {

                sh '''
                    echo "=========================================="
                    echo "JAVA VERSION"
                    echo "=========================================="

                    java -version

                    echo ""
                    echo "=========================================="
                    echo "JAVAC VERSION"
                    echo "=========================================="

                    javac -version

                    echo ""
                    echo "=========================================="
                    echo "JAVA HOME"
                    echo "=========================================="

                    echo "$JAVA_HOME"

                    echo ""
                    echo "=========================================="
                    echo "MAVEN VERSION"
                    echo "=========================================="

                    mvn -version
                '''
            }
        }

        // =====================================================
        // 4. MAVEN CLEAN
        // =====================================================

        stage('Maven Clean') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "MAVEN CLEAN"
                        echo "=========================================="

                        mvn clean
                    '''
                }
            }
        }

        // =====================================================
        // 5. COMPILE
        // =====================================================

        stage('Compile') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "MAVEN COMPILE"
                        echo "=========================================="

                        mvn compile
                    '''
                }
            }
        }

        // =====================================================
        // 6. UNIT TEST
        // =====================================================

        stage('Test') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "UNIT TEST"
                        echo "=========================================="

                        mvn test
                    '''
                }
            }
        }

        // =====================================================
        // 7. SONARQUBE ANALYSIS
        // =====================================================

        stage('SonarQube Analysis') {

            steps {

                dir("${APP_DIR}") {

                    withSonarQubeEnv('sonar') {

                        withCredentials([ usernamePassword: 'sonarqube-token',usernameVariable: 'SONAR_USER', passwordVariable: 'SONAR_TOKEN']) {

                            echo "SONAR CREDENTIAL BLOCK STARTED"

                            sh '''
                                echo "=========================================="
                                echo "SONARQUBE ANALYSIS"
                                echo "=========================================="

                                echo "Current directory:"
                                pwd

                                echo ""
                                echo "Checking pom.xml:"
                                ls -lh pom.xml

                                echo ""
                                echo "Maven version:"
                                mvn -version

                                echo ""
                                echo "SonarQube URL:"
                                echo "$SONAR_HOST_URL"

                                echo ""
                                echo "Starting SonarQube analysis..."
                                mvn clean verify sonar:sonar \
                                  -Dsonar.projectKey=bank1 \
                                  -Dsonar.host.url=http://35.180.123.141:9000 \
                                  -Dsonar.login=${SONAR_TOKEN}
                                    -Dsonar.java.binaries=target/classes

                                echo ""
                                echo "=========================================="
                                echo "SONARQUBE ANALYSIS COMPLETED"
                                echo "=========================================="

                                echo ""
                                echo "Checking report-task.txt..."

                                find . -name "report-task.txt" -print
                            '''
                        }
                    }
                }
            }
        }

        // =====================================================
        // 8. QUALITY GATE
        // =====================================================

        stage('Quality Gate') {

            steps {

                echo "=========================================="
                echo "SONARQUBE QUALITY GATE"
                echo "=========================================="

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: false
                    )
                }
            }
        }

        // =====================================================
        // 9. CREATE JAR
        // =====================================================

        stage('Package') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "CREATING JAR"
                        echo "=========================================="

                        mvn package -DskipTests
                    '''
                }
            }
        }

        // =====================================================
        // 10. SHOW BUILD ARTIFACT
        // =====================================================

        stage('Show Artifact') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "BUILD ARTIFACT"
                        echo "=========================================="

                        ls -lh target/

                        echo ""
                        echo "JAR FILES:"
                        find target -maxdepth 1 -type f -name "*.jar" -ls
                    '''
                }
            }
        }

        // =====================================================
        // 11. DOCKER CHECK
        // =====================================================

        stage('Docker Check') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "DOCKER CHECK"
                    echo "=========================================="

                    docker --version

                    echo ""
                    echo "Docker information:"
                    docker info
                '''
            }
        }

        // =====================================================
        // 12. DOCKER BUILD
        // =====================================================

        stage('Docker Build') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "BUILDING DOCKER IMAGE"
                        echo "=========================================="

                        echo "Docker image:"
                        echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                        docker build \
                            -t "${DOCKER_IMAGE}:${IMAGE_TAG}" \
                            .

                        echo ""
                        echo "=========================================="
                        echo "DOCKER BUILD COMPLETED"
                        echo "=========================================="

                        docker images "${DOCKER_IMAGE}"
                    '''
                }
            }
        }

        // =====================================================
        // 13. DOCKER IMAGE CHECK
        // =====================================================

        stage('Docker Image Check') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "DOCKER IMAGE CHECK"
                    echo "=========================================="

                    docker images "${DOCKER_IMAGE}"

                    echo ""
                    echo "Image created:"
                    echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                    docker image inspect "${DOCKER_IMAGE}:${IMAGE_TAG}" > /dev/null

                    echo "Docker image verification successful."
                '''
            }
        }

        // =====================================================
        // 14. DOCKER LOGIN
        // =====================================================

        stage('Docker Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "=========================================="
                        echo "DOCKER HUB LOGIN"
                        echo "=========================================="

                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        echo "Docker Hub login successful."
                    '''
                }
            }
        }

        // =====================================================
        // 15. DOCKER PUSH
        // =====================================================

        stage('Docker Push') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "PUSHING DOCKER IMAGE"
                    echo "=========================================="

                    echo "Docker Image:"
                    echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                    docker push "${DOCKER_IMAGE}:${IMAGE_TAG}"

                    echo ""
                    echo "=========================================="
                    echo "DOCKER PUSH COMPLETED"
                    echo "=========================================="
                '''
            }
        }

        // =====================================================
        // 16. DOCKER LOGOUT
        // =====================================================

        stage('Docker Logout') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "DOCKER LOGOUT"
                    echo "=========================================="

                    docker logout || true

                    echo "Docker logout completed."
                '''
            }
        }
    }

    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo '''
            ==========================================
              BANKING APPLICATION PIPELINE SUCCESS
            ==========================================
            '''

            echo "Application build completed successfully."
            echo "Build Number : ${BUILD_NUMBER}"
            echo "Docker Image : ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }

        failure {

            echo '''
            ==========================================
              BANKING APPLICATION PIPELINE FAILED
            ==========================================
            '''

            echo "Build Number : ${BUILD_NUMBER}"
            echo "Check the Jenkins Console Output."
        }

        always {

            echo "=========================================="
            echo "BUILD INFORMATION"
            echo "=========================================="

            echo "BUILD NUMBER : ${BUILD_NUMBER}"
            echo "BUILD STATUS : ${currentBuild.currentResult}"
        }
    }
}
