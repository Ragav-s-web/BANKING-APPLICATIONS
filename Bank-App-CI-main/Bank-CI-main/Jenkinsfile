pipeline {

    agent any

    // =========================================================
    // TOOLS
    // =========================================================

    tools {
        jdk 'Java21'
        maven 'Maven'
    }

    // =========================================================
    // ENVIRONMENT
    // =========================================================

    environment {

        // Application directory
        APP_DIR = 'Bank-App-CI-main/Bank-CI-main'

        // SonarQube
        SONAR_PROJECT_KEY = 'gcbank'
        SONAR_PROJECT_NAME = 'gcbank'

        // Docker Hub
        DOCKER_IMAGE = 'castromeka/gcbank'
        IMAGE_TAG = "v${BUILD_NUMBER}"
    }

    // =========================================================
    // STAGES
    // =========================================================

    stages {

        // =====================================================
        // 1. CLEAN WORKSPACE
        // =====================================================

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }


        // =====================================================
        // 2. GIT CHECKOUT
        // =====================================================

        stage('Git Checkout') {
            steps {

                git(
                    branch: 'main',
                    credentialsId: 'git-token',
                    url: 'https://github.com/Ragav-s-web/BANKING-APPLICATIONS.git'
                )
            }
        }


        // =====================================================
        // 3. CHECK JAVA AND MAVEN
        // =====================================================

        stage('Check Java & Maven') {
            steps {

                sh '''
                    echo "=========================================="
                    echo "JAVA VERSION"
                    echo "=========================================="

                    java -version

                    echo ""
                    echo "=========================================="
                    echo "JAVAC VERSION"
                    echo "=========================================="

                    javac -version

                    echo ""
                    echo "=========================================="
                    echo "JAVA HOME"
                    echo "=========================================="

                    echo "$JAVA_HOME"

                    echo ""
                    echo "=========================================="
                    echo "MAVEN VERSION"
                    echo "=========================================="

                    mvn -version
                '''
            }
        }


        // =====================================================
        // 4. MAVEN CLEAN
        // =====================================================

        stage('Maven Clean') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "MAVEN CLEAN"
                        echo "=========================================="

                        mvn clean
                    '''
                }
            }
        }


        // =====================================================
        // 5. COMPILE
        // =====================================================

        stage('Compile') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "MAVEN COMPILE"
                        echo "=========================================="

                        mvn compile
                    '''
                }
            }
        }


        // =====================================================
        // 6. UNIT TEST
        // =====================================================

        stage('Test') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "UNIT TEST"
                        echo "=========================================="

                        mvn test
                    '''
                }
            }
        }


        // =====================================================
        // 7. SONARQUBE ANALYSIS
        // =====================================================

       stage('SonarQube Analysis') {
    steps {
        dir("${APP_DIR}") {

            withSonarQubeEnv('sonar') {

                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "=========================================="
                        echo "SONARQUBE ANALYSIS"
                        echo "=========================================="

                        echo "Current directory:"
                        pwd

                        echo "Maven version:"
                        mvn -version

                        echo "Starting SonarQube..."

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.7.0.6970:sonar \
                            -Dsonar.projectKey=gcbank \
                            -Dsonar.projectName=gcbank \
                            -Dsonar.host.url="${SONAR_HOST_URL}" \
                            -Dsonar.token="${SONAR_TOKEN}" \
                            -Dsonar.java.binaries=target/classes

                        echo "=========================================="
                        echo "SONARQUBE COMPLETED"
                        echo "=========================================="

                        echo "Checking report-task.txt..."

                        find . -name "report-task.txt" -print
                    '''
                }
            }
        }
    }
}


        // =====================================================
        // 8. QUALITY GATE
        // =====================================================

        stage('Quality Gate') {
            steps {

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: false
                    )
                }
            }
        }


        // =====================================================
        // 9. CREATE JAR
        // =====================================================

        stage('Package') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "CREATING JAR"
                        echo "=========================================="

                        mvn package -DskipTests
                    '''
                }
            }
        }


        // =====================================================
        // 10. SHOW BUILD ARTIFACT
        // =====================================================

        stage('Show Artifact') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "BUILD ARTIFACT"
                        echo "=========================================="

                        ls -lh target/
                    '''
                }
            }
        }


        // =====================================================
        // 11. DOCKER BUILD
        // =====================================================

        stage('Docker Build') {
            steps {

                dir("${APP_DIR}") {

                    sh '''
                        echo "=========================================="
                        echo "BUILDING DOCKER IMAGE"
                        echo "=========================================="

                        docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} .

                        echo ""
                        echo "Docker image created:"
                        echo "${DOCKER_IMAGE}:${IMAGE_TAG}"
                    '''
                }
            }
        }


        // =====================================================
        // 12. DOCKER IMAGE CHECK
        // =====================================================

        stage('Docker Image Check') {
            steps {

                sh '''
                    echo "=========================================="
                    echo "DOCKER IMAGE CHECK"
                    echo "=========================================="

                    docker images ${DOCKER_IMAGE}

                    echo ""
                    echo "IMAGE:"
                    echo "${DOCKER_IMAGE}:${IMAGE_TAG}"
                '''
            }
        }


        // =====================================================
        // 13. DOCKER LOGIN
        // =====================================================

        stage('Docker Login') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "=========================================="
                        echo "DOCKER HUB LOGIN"
                        echo "=========================================="

                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin
                    '''
                }
            }
        }


        // =====================================================
        // 14. PUSH DOCKER IMAGE
        // =====================================================

        stage('Docker Push') {
            steps {

                sh '''
                    echo "=========================================="
                    echo "PUSHING DOCKER IMAGE"
                    echo "=========================================="

                    echo "Docker Image:"
                    echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                '''
            }
        }


        // =====================================================
        // 15. DOCKER LOGOUT
        // =====================================================

        stage('Docker Logout') {
            steps {

                sh '''
                    echo "=========================================="
                    echo "DOCKER LOGOUT"
                    echo "=========================================="

                    docker logout || true
                '''
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo '''
            ==========================================
              BANKING APPLICATION PIPELINE SUCCESS
            ==========================================
            '''

            echo "Application build completed successfully."
            echo "Build Number : ${BUILD_NUMBER}"
            echo "Docker Image : ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }


        failure {

            echo '''
            ==========================================
              BANKING APPLICATION PIPELINE FAILED
            ==========================================
            '''

            echo "Build Number : ${BUILD_NUMBER}"
            echo "Check the Jenkins Console Output."
        }


        always {

            echo "=========================================="
            echo "BUILD INFORMATION"
            echo "=========================================="

            echo "BUILD NUMBER : ${BUILD_NUMBER}"
            echo "BUILD STATUS : ${currentBuild.currentResult}"
        }
    }
}
